# P0080 preserved P76 native regressions.
PYTHON ?= python3
PRODUCTION_HOSTFLAGS := $(EXTRA_HOSTFLAGS) -std=c11 -g -O1 -Wall -Wextra -Werror -fsanitize=address,undefined -Ifirmware/include
# Historical scenarios explicitly retain their40C contract.
HOSTFLAGS := $(PRODUCTION_HOSTFLAGS) -DEFFECT_SUPPLY_LIMIT_CC=4000
HEADERS := $(wildcard firmware/include/*.h)
CN := firmware/src/debug_telemetry.c firmware/src/debug_command.c firmware/src/cn105.c firmware/src/service.c firmware/src/telemetry.c firmware/src/control.c firmware/src/effect.c firmware/src/effect_model.c firmware/src/effect_feedback.c firmware/src/identity.c
HOST_TESTS := build/gain-seed-test build/effect45-test build/effect-braking-test build/control-experimental-test build/cn-experimental-test build/tele-experimental-test build/effect-model-test build/thermal-envelope-test build/effect-sessions-test build/effect-source-test build/raw-test  build/predictive-test build/atomic-entry-test build/host-test build/cn-test build/tele-test build/control-test build/effect-test build/feedback-test build/address-test build/pause-test build/snapshot-test
build/host-test: tests/test_modbus.c firmware/src/modbus.c $(CN) $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) $(filter %.c,$^) -o $@
build/cn-test: tests/test_cn105.c $(CN) $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) $(filter %.c,$^) -o $@
build/tele-test: tests/test_telemetry.c firmware/src/telemetry.c firmware/src/service.c $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) $(filter %.c,$^) -o $@
build/control-test: tests/effect_source_fixture.c tests/test_control.c firmware/src/control.c firmware/src/effect.c firmware/src/effect_model.c $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) $(filter %.c,$^) -o $@
build/effect-test: tests/effect_source_fixture.c tests/test_effect.c firmware/src/control.c firmware/src/effect.c firmware/src/effect_model.c $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) $(filter %.c,$^) -o $@
build/feedback-test: tests/test_effect_feedback.c firmware/src/effect_feedback.c firmware/src/telemetry.c firmware/src/service.c $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) $(filter %.c,$^) -o $@
build/address-test: tests/test_addressing.c firmware/src/modbus.c firmware/src/identity.c firmware/src/debug_command.c $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) -DUNIT_TEST $(filter %.c,$^) -o $@
build/pause-test: tests/test_pause_integration.c firmware/src/control.c firmware/src/effect.c firmware/src/effect_model.c firmware/src/effect_feedback.c firmware/src/telemetry.c firmware/src/service.c $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) $(filter %.c,$^) -o $@
build/predictive-test: tests/effect_source_fixture.c tests/test_predictive_candidate.c firmware/src/effect.c firmware/src/effect_model.c $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) $(filter %.c,$^) -o $@
build/atomic-entry-test: tests/effect_source_fixture.c tests/test_atomic_entry_candidate.c firmware/src/control.c firmware/src/effect.c firmware/src/effect_model.c $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) $(filter %.c,$^) -o $@
build/raw-test: tests/test_raw_diagnostic.c firmware/src/modbus.c $(CN) $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) $(filter %.c,$^) -o $@
host-test: $(HOST_TESTS)
	./build/gain-seed-test
	./build/effect45-test
	./build/control-experimental-test
	./build/cn-experimental-test
	./build/tele-experimental-test
	./build/effect-model-test
	./build/thermal-envelope-test
	./build/effect-sessions-test
	./build/effect-source-test
	./build/effect-braking-test
	./build/raw-test
	$(PYTHON) tests/test_raw_mapper.py
	./build/predictive-test
	./build/atomic-entry-test
	./build/host-test
	./build/cn-test
	./build/tele-test
	./build/control-test
	./build/effect-test
	./build/feedback-test
	./build/address-test
	./build/pause-test
	./build/snapshot-test
	$(PYTHON) tests/test_read_snapshot.py
	$(PYTHON) tests/test_control_command.py
	$(PYTHON) tests/test_read_mvp.py
	$(PYTHON) tests/test_commission_units.py

build/snapshot-test: tests/test_snapshot.c firmware/src/modbus.c $(CN) $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) $(filter %.c,$^) -o $@

build/effect-sessions-test: tests/test_effect_sessions.c tests/effect_source_fixture.c firmware/src/control.c firmware/src/effect.c firmware/src/effect_model.c $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) $(filter %.c,$^) -o $@
build/effect-source-test: tests/test_effect_source.c tests/effect_source_fixture.c firmware/src/effect.c firmware/src/effect_model.c $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) $(filter %.c,$^) -o $@
build/thermal-envelope-test: tests/test_thermal_envelope.c tests/effect_source_fixture.c firmware/src/effect.c firmware/src/effect_model.c $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) $(filter %.c,$^) -o $@

build/effect-model-test: tests/test_effect_model.c firmware/src/effect_model.c $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) $(filter %.c,$^) -o $@

build/gain-seed-test: tests/test_gain_seed.c firmware/src/debug_command.c firmware/src/effect_model.c firmware/src/identity.c firmware/src/modbus.c $(HEADERS)
	mkdir -p build
	# Intentionally omit UNIT_TEST: exercise the production C077 adapter.
	clang $(HOSTFLAGS) $(filter %.c,$^) -o $@

build/control-experimental-test: tests/effect_source_fixture.c tests/test_control.c firmware/src/control.c firmware/src/effect.c firmware/src/effect_model.c $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) -DPROCON_DELTA_SWEEP=1 $(filter %.c,$^) -o $@

build/cn-experimental-test: tests/test_cn105.c $(CN) $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) -DPROCON_DELTA_SWEEP=1 $(filter %.c,$^) -o $@

build/tele-experimental-test: tests/test_telemetry.c firmware/src/telemetry.c firmware/src/service.c $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) -DPROCON_DELTA_SWEEP=1 $(filter %.c,$^) -o $@

build/effect-braking-test: tests/test_effect_braking.c tests/effect_source_fixture.c firmware/src/effect.c firmware/src/effect_model.c $(HEADERS)
	mkdir -p build
	clang $(HOSTFLAGS) $(filter %.c,$^) -o $@

build/effect45-test: tests/test_effect45.c tests/effect_source_fixture.c firmware/src/control.c firmware/src/effect.c firmware/src/effect_model.c $(HEADERS)
	mkdir -p build
	clang $(PRODUCTION_HOSTFLAGS) $(filter %.c,$^) -o $@
